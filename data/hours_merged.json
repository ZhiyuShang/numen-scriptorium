"hours_origin":  
[
{
      "name_en": "Gods-from-Blood",
      "name_cn": "血源诸神",
      "desc_cn": "血源诸神是通过献祭凡物或古老力量而扬升的司辰，既继承被献祭者的权柄，又在本质上发生扭曲与变异。飞蛾与赤杯是最早的血源诸神，它们由猎人献祭飞鸟与野兽而生，分别与天空与大地相关，却不再具备飞禽走兽的形象。在石源诸神衰落、光源诸神尚未完全降临的空档期，血源诸神曾有机会主宰漫宿，但飞蛾与赤杯之间未能形成牢固同盟，反而渐生敌意，各自追求不同未来，最终让光源诸神在覆石之战后夺得主导地位。"
    },
  {
      "name_en": "Gods-from-Stone",
      "name_cn": "石源诸神",
      "desc_cn": "石源诸神被称为“先于人类的司辰”“最初的司辰”，是最早统治世间并构筑漫宿基础的神明。祂们被认为修建了漫宿最原始的结构，并立下第一批法则，例如“梦境的钥匙无法被持有”，由此催生了丽姬亚等特殊群体。石源诸神在漫长岁月中共享统治，将彼此视为手足，但最终在覆石之战中几乎全灭：转轮、浪潮、燧石、七蟠先后被后来诸神取代，逆孵之卵逃入辉光，仅余双角斧一位石源神苟存。石源诸神的残余与旧法则仍深藏世界各处，对现秩序既是隐患也是不可或缺的支架。"
    },
  {
      "name_en": "Gods-from-Light",
      "name_cn": "光源诸神",
      "desc_cn": "光源诸神是从辉光中降临或与辉光紧密相连的司辰，其中真正“诞生于辉光”的仅有骄阳、白日铸炉和半个制花人，残阳、弧月、昕旦则曾是骄阳的面相，守夜人则是不智凡人与逆孵之卵在辉光中合一后的新形态。共享辉光作为力量源泉，使光源诸神内部联系紧密，骄阳与白日铸炉的同盟曾确立其统治地位，但“置闰”事件重创了这一阵营：骄阳被分裂，铸炉远离前线，他们的缺位由多位新光源司辰勉强填补。尽管经历打击，光源诸神依旧是漫宿中最重要的司辰派系之一。"
    },
  {
      "name_en": "Gods-from-Flesh",
      "name_cn": "肉源诸神",
      "desc_cn": "肉源诸神是由凡类飞升而来的司辰，多数曾为人类，也可能包括介壳种等非人智慧种族。在数量上，这是漫宿中占比最大的司辰群体，但他们飞升路径多样，性格与欲望迥异，难以形成统一阵营。许多肉源神是由光源或血源诸神提拔，用以接管石源诸神死后留下的权柄与职责，因此自诞生之初便带着某种立场或偏向。无论选择尊重还是反叛提拔者，大多数肉源诸神都难以完全摆脱漫宿权力斗争，却也很少成为决定局势的关键力量，这使得部分肉源神宁愿远离斗争核心，专注于维护自身领域与职能。"
    },
  {
      "name_en": "Gods-from-Nowhere",
      "name_cn": "虚源诸神",
      "desc_cn": "虚源诸神与虚界有极为紧密的联系：有的长期居于虚界，有的被迫留在那里，甚至有的“所到之处即为虚界”。祂们执掌的权柄格外危险，例如白雪的静默、蜘蛛的统治、戴冠之孳的感染、光明果的变异、牝马的谎言，因此备受漫宿现存司辰的警惕。由于法则所限，虚源诸神在虚界之外难以施展全力，必须先将环境改造成类似虚界的状态；这与受虚界影响的蠕虫的目标相似——蠕虫意图将漫宿整体蚕食为虚界，这也促成了两者之间的有限协定。虚源诸神最大的夙愿是在突破封锁后直接触及醒时世界与漫宿：白雪与戴冠之孳都曾接近这一目标，却遭到其他司辰的阻拦。如果有一天虚源诸神真正成功降临，那样的未来大概率不会是凡人的乐土。"
    },
  {
      "name_en": "Gods-from-Steel",
      "name_cn": "钢源诸神",
      "desc_cn": "钢源诸神被定义为由凡人“制造”的司辰，在当前时代尚未真正出现。现存诸神本能地否认钢源神的合理性，因为一旦承认凡人可以铸造新的神明，现有秩序就不再稳固。零星预示表明，在未来的“太阳大战”中，大量司辰被除名、权柄出现真空，人造司辰或许会在工业与高度发达文明的背景下诞生：以钢铁、机械与工厂的轰鸣取代古老祭坛。关于钢源诸神的具体形态与法则目前仍所知甚少。"
    },
  {
      "name_en": "The God of Amber",
      "name_cn": "琥珀神",
      "desc_cn": "逆孵之卵曾是石源诸神之一，后来以“守夜人”的身份归来，被视为一种独特的“琥珀神”。守夜人既保留了旧日石源神的残影，又在辉光中与一位不智凡人合一，因此在分类上既被称作肉源神，又与光源诸神关系紧密，却都不完全贴切。他像一只被封存在琥珀中的远古昆虫：既是被保存的旧日形象，又是新生且充满矛盾的神明。当传统的石源、光源、肉源三种起源都无法概括他的身世时，“琥珀神”这个称呼或许最为恰当。"
    }
],
"hours_factions":  
[
{
    "name_en": "Hours of the Day / Solar Hours",
    "name_cn": "白日司辰 / 太阳司辰",
    "desc_cn": "白日司辰曾是漫宿中势力最庞大、地位最核心的司辰派系，起源于骄阳与白日铸炉的紧密同盟。在“置闰”事件后，太阳之位被拆分为多个面向，由弧月、残阳、昕旦、守夜人与裂分之狼五位司辰共同分享“太阳”的名号与权柄，无敌太阳教会也将这五位尊奉为正统的“太阳司辰”。\n\n白日司辰在政治与神秘层面都拥有极深影响：弧月与昕旦分别隶属“圣坛三神”“根冠三神”，守夜人掌握灯之主要飞升途径，使白日阵营始终处于上层结构。然而庞大权柄伴随着严重内部分裂：守夜人与根冠法则对立，弧月在月亮居屋中另有盘算，残阳渴望自毁，裂分之狼则倾向毁灭世界本身。白日司辰一方面象征王权与秩序，另一方面也预示着内部矛盾与潜在崩裂。"
},
{
  "name_en": "Hours of the Knot / Triple Knot",
  "name_cn": "绳结司辰 / 三重绳结司辰",
  "desc_cn": "绳结司辰是由赤杯主导、旨在挑战白日司辰优势地位的司辰阵营，在漫宿斗争中的活跃度仅次于太阳司辰。其核心为三重绳结司辰：赤杯、环杉与最后的石源神双角斧，这一同盟建立在赤杯具名者松树骑士的牺牲与一纸“最终条约”之上，象征现存居屋之神与被取代旧神之间的危险妥协。绳结司辰主要由赤杯的野心与双角斧的仇恨驱动，内部矛盾公开而尖锐，从对历史的分歧到麾下祭司派系的争执，使其在与太阳司辰及无敌太阳教会的长期对抗中逐渐处于下风。出于“敌人的敌人就是盟友”的考虑，绳结阵营对曾信奉石源诸神的介壳遗族等黑夜生灵相对宽容，三位绳结女神麾下皆有出身介壳的具名者，姐妹会修女也与介壳遗族和丘陵之子保持往来，这与将异族视为威胁、倾向于清除的教会与官方立场形成鲜明对比。"
},
{
  "name_en": "Hours of the Wood",
  "name_cn": "林地司辰",
  "desc_cn": "林地司辰指那些长居于林地而非漫宿居屋的司辰。祂们彼此联系并不紧密，也少有以统一立场介入大事件，因此严格意义上并非一个固定派系。但林地位于漫宿之外又近在咫尺，这几位司辰共同选择此处为居所，本身就暗示了某种态度：在漫宿斗争的大部分时间里置身事外，却在关键时刻保留插手的余地。太阳大战期间，长期远离正面冲突的飞蛾洞见了根冠的破绽，在极短时间内组织起反抗力量并成功推翻根冠，几乎可以视为这种“林地策略”的典型范例。"
},
{
  "name_en": "Hours of the Roost / Aviform Hours",
  "name_cn": "栖木司辰 / 鸟形司辰",
  "desc_cn": "栖木司辰是那些以飞禽形态会面、在“栖木”交换传闻与闲话的司辰。祂们普遍远离漫宿居屋、与醒时世界联系更为紧密，因此相对而言对人类较为宽厚。虽然栖木远离司辰斗争的核心，但乌鸦的窥伺、白鸽的铭记、笑鸫的无所不至与孪鸢对历史的编织，使得鸟形司辰对其他司辰的隐秘与阴谋反而知之甚详，形成了一个司辰级别的情报网络。所幸祂们对参与权力争斗兴趣有限，严格限制这些情报的传播，因此得以保持超然地位。\n\n鸟形司辰继承了石源诸神的歌与部分古老法则，这既让祂们的交流在其他司辰眼中也近乎隐语，也解释了祂们对维持现状的偏好：若石源神复活，则继承法则的独特价值消失；若石源残余被彻底清除，则法则直接失效。维持局面的暧昧稳定对栖木而言最为有利。尽管如此，鸟形司辰并非完全无野心：浪游旅人曾参与针对骄阳的阴谋并间接引发置闰，又在太阳大战前与飞蛾结盟对抗根冠，种种冲突也可能是太阳大战后栖木司辰不再集会的原因。"
}
]
}